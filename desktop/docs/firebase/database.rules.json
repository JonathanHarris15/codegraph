// See docs/firebase.md. Rooms: who is where right now, and what they hold.
// roomMembers is copied from Firestore by a member on the way into a room,
// since these rules cannot read Firestore.
{
  "rules": {
    "roomMembers": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && root.child('roomMembers').child($room).child(auth.token.firebase.identities['github.com'][0]).exists()",
        ".write": "auth != null && root.child('roomMembers').child($room).child(auth.token.firebase.identities['github.com'][0]).exists()"
      }
    }
  }
}

rules_version = '2';
// DRAFT: not yet run. See docs/firebase.md.
service firebase.storage {
  match /b/{bucket}/o {
    function me() { return request.auth.token.firebase.identities['github.com'][0]; }
    function project(id) { return firestore.get(/databases/(default)/documents/projects/$(id)); }

    match /projects/{id}/{rest=**} {
      allow read: if request.auth != null && me() in project(id).data.memberIds;
      allow write: if request.auth != null && project(id).data.roles[me()] in ['owner', 'co-owner', 'collaborator'];
    }
    match /members/{member}/{rest=**} {
      allow read, write: if request.auth != null && member == me();
    }
    match /sketches/{id}/{rest=**} {
      allow read, write: if request.auth != null && me() in firestore.get(/databases/(default)/documents/sketches/$(id)).data.memberIds;
    }
  }
}

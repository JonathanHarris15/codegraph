{
  "name": "codegraph-desktop",
  "version": "0.1.0",
  "description": "The codegraph app: your projects, their software systems, and a map of each read from its code.",
  "author": "Jonathan Harris",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
